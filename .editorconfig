# https://editorconfig.org — keeps whitespace consistent across editors so diffs
# stay about behavior, not formatting. rustfmt remains the source of truth for Rust.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
