# ─── credvault configuration (Twelve-Factor: all config via env) ───────────────
# Copy to .env and fill in. NEVER commit real secrets.

# Required: Postgres connection string.
VAULT_DATABASE_URL=postgres://vault:vault@localhost:5432/vault

# Encryption keyring. JSON map of {version: base64url-32-byte-key}.
# Generate keys with: credvault gen-key
# Secrets may also be supplied out-of-band via a mounted file, using the *_FILE
# convention (e.g. VAULT_KEYS_FILE=/run/secrets/vault_keys), which is preferred in
# production so secrets never appear in the process environment.
VAULT_KEYS={"1":"yKeukaLqoCq7aUu8JcHvV3CkkEE7R2jmlULlpBo2ng8="}
VAULT_ACTIVE_KEY=1

# REQUIRED, no default. Secret used to sign OAuth "state" (CSRF). Must be >= 32 bytes.
# Generate with: openssl rand -base64 32   (or set VAULT_STATE_SECRET_FILE)
VAULT_STATE_SECRET=c5o6HxwxZoEtnvI-maNeW7zElEufzJA--z5iuqf0BrU=

# REQUIRED, no default. Bearer token for admin endpoints (tenant provisioning). Must be
# >= 32 bytes. Generate with: openssl rand -base64 32   (or set VAULT_ADMIN_TOKEN_FILE)
VAULT_ADMIN_TOKEN=-SEf1OajqEsN8El4ovbbx_qI4kA4FjelD40waNWCv9s=

# Public base URL the provider redirects back to (OAuth callback host).
VAULT_PUBLIC_BASE_URL=http://localhost:8000

# Web server bind host + port. Defaults to loopback (127.0.0.1); set 0.0.0.0 to expose
# (containers do this explicitly).
VAULT_BIND_HOST=127.0.0.1
PORT=8000

# Security knobs.
#   VAULT_ALLOW_INSECURE_HTTP=1  permit http:// provider endpoints + skip DB-TLS check
#                               (LOCAL DEV ONLY; production requires https end to end).
#   VAULT_RATE_LIMIT_PER_MINUTE  per-IP request budget on the API (0 disables).
#   VAULT_MAX_BODY_BYTES         max request body size.
VAULT_ALLOW_INSECURE_HTTP=0
VAULT_RATE_LIMIT_PER_MINUTE=120
VAULT_MAX_BODY_BYTES=65536

# Refresh tuning (seconds).
VAULT_STATE_TTL_SECONDS=600
VAULT_REFRESH_SKEW_SECONDS=120
VAULT_REFRESH_HORIZON_SECONDS=600
VAULT_WORKER_INTERVAL_SECONDS=60
VAULT_REFRESH_MAX_ATTEMPTS=5
VAULT_HTTP_TIMEOUT_SECONDS=15

# ─── Extending the catalog without recompiling ────────────────────────────────
# Add or override providers at runtime as JSON. Built-ins are always present; an
# entry whose "name" matches a built-in replaces it. Use a file path and/or inline
# JSON (both are merged; inline wins on conflicts). Invalid config fails at startup.
#   VAULT_PROVIDERS_FILE=/etc/credvault/providers.json
#   VAULT_PROVIDERS_JSON=[{"name":"linear","auth_type":"oauth2","authorize_url":"https://linear.app/oauth/authorize","token_url":"https://api.linear.app/oauth/token","client_id_env":"LINEAR_CLIENT_ID","client_secret_env":"LINEAR_CLIENT_SECRET","default_scopes":["read"]}]
# See providers.example.json for the full shape. Secrets stay in env (client_id_env
# / client_secret_env name the vars); only non-secret metadata goes in JSON.
VAULT_PROVIDERS_FILE=
VAULT_PROVIDERS_JSON=

# Per-provider OAuth client credentials (only set the ones you use).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Logs: structured JSON to stdout. Tune with RUST_LOG (e.g. info, credvault=debug).
RUST_LOG=info
